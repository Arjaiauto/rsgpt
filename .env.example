# Copy to .env and fill in. Never commit .env.
# The pipeline scripts and the site (site/next.config.ts) both read this one file.
# Vercel: set variables in the project's Environment Variables, not from this file.
# "Prod" = Production only (AI keys, on purpose, so previews cannot spend API credit).
# "Prod + Preview" = needed on preview deployments as well.
# "Not on Vercel" = read only by pipeline scripts on this PC.

# --- Site: login and sessions (Vercel: Prod + Preview) ---
# Shared password for the login page.
SITE_PASSWORD=
# Secret that signs the session cookie. Any long random string.
SESSION_SECRET=

# --- Supabase database (Vercel: Prod + Preview) ---
# Project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Service-role key. Server only; never expose it to the browser.
SUPABASE_SERVICE_KEY=
# Postgres password. Not read by any code in this repo; kept for direct database tools.
SUPABASE_DB_PASSWORD=

# --- Site: public URL (Vercel: Prod + Preview, optional) ---
# Base URL for metadata and links. Leave empty to use https://cuepoint-two.vercel.app.
NEXT_PUBLIC_SITE_URL=

# --- AI and search keys (Vercel: Prod only) ---
# Anthropic: Ask answers, Prep brief, and the clip extraction in the pipeline.
ANTHROPIC_API_KEY=
# Voyage AI: embeddings for search (Ask, Prep, Clips search).
VOYAGE_API_KEY=
# Groq: speech-to-text for captions (pipeline), and the Prep web research (site).
GROQ_API_KEY=
# Tavily: web search for Prep web research (site).
TAVILY_API_KEY=
# Sarvam: Hindi speech-to-text for captions (pipeline only).
SARVAM_API_KEY=

# --- YouTube (Not on Vercel: pipeline only) ---
# YouTube Data API key: episode lists and guest channel links.
YOUTUBE_API_KEY=

# --- Optional debugging (Vercel: not needed) ---
# Set to 1 in local development to print Prep model output. Ignored in production builds.
# PREP_DEBUG=1
